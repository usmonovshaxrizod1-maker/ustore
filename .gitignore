# Unlike the previous rebrand round, there is no separate "real" config.js
# to exclude here — config.public.js is the ONLY frontend config file, and
# it is designed to be safe to publish (see its own header comment). Every
# actual secret (bot tokens, USTORE_BOT_TOKEN_MASTER_KEY, BOSS_SHARED_SECRET,
# CRON_SHARED_SECRET, Azure keys, the Supabase service_role key) lives only
# in Supabase Edge Function secrets — never in a file in this repo.

# OS/editor junk
.DS_Store
Thumbs.db
node_modules/
.npm-cache/
*.log
dist/
.env
.env.local

# Local database backups
*_backup.sql
*.backup

# Supabase CLI local state
supabase/.temp/
# Destructive local maintenance script
supabase/RESET_TEST_SHOPS_EXCEPT_FITCORE.sql

# Generated local release audit evidence; keep reviewed examples in Git.
docs/web/release-evidence/ASTRA_10A_AUDIT.json
docs/web/release-evidence/ASTRA_10A_MIGRATION_LEDGER.json
docs/web/release-evidence/ASTRA_10B_DEPLOY_PLAN.json
docs/web/release-evidence/ASTRA_10C_RELEASE_CANDIDATE.json
