# Faqat nomlar va bo'sh namunalar. Haqiqiy qiymatlarni Git/ZIP ichiga yozmang.
# Ularni Supabase Dashboard -> Edge Functions -> Secrets orqali kiriting.

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# 32 baytli tasodifiy AES kaliti (base64). Bot tokeni hamda BILLZ/Click/Payme
# maxfiy ma'lumotlari shu kalit bilan serverda shifrlanadi.
USTORE_BOT_TOKEN_MASTER_KEY=""

USTORE_SUPER_ADMIN_ID=""
USTORE_PLATFORM_BOT_TOKEN=""
PLATFORM_MINI_APP_URL=""
SHOP_MINI_APP_BASE_URL=""

# Har bir cron uchun alohida uzun tasodifiy qiymat ishlating.
USTORE_PLATFORM_CRON_SECRET=""
USTORE_BILLZ_CRON_SECRET=""
USTORE_REPORT_EXPORT_CRON_SECRET=""
CRON_SHARED_SECRET=""

BOSS_SHARED_SECRET=""
EXCEL_TEMPLATE_BUCKET="excel-templates"

# Ixtiyoriy tarjima xizmati.
AZURE_TRANSLATOR_ENDPOINT=""
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION=""
# Premium web auth (Astra-4b+)
USTORE_PLATFORM_BOT_USERNAME=""
# BotFather > Login Widget: server-side OIDC credentials. Never publish the secret.
USTORE_TELEGRAM_OIDC_CLIENT_ID=""
USTORE_TELEGRAM_OIDC_CLIENT_SECRET=""
WEB_AUTH_ALLOWED_ORIGINS="https://ustr.uz,https://www.ustr.uz"
WEB_APP_BASE_URL="https://ustr.uz"

# Domain / custom-hostname provisioning (server-side only).
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_SAAS_CNAME_TARGET=""
USTORE_CUSTOM_DOMAIN_ROUTING_READY="false"
USTORE_WILDCARD_READY="true"
USTORE_CUSTOM_DOMAIN_MINI_APP_ENABLED="false"

# Canonical/central web routing. Confirm owned production hostname before setting.
USTORE_BASE_HOSTNAME="ustr.uz"
WEB_AUTH_CENTRAL_URL="https://ustr.uz"
